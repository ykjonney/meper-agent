# Caddy configuration for Agent Flow
# Serves frontend-studio (management at /) + frontend-client (end-user at /client/) + reverse proxies API

:80 {
	root * /srv

	# Backend API proxy
	# flush_interval -1：流式响应（SSE token 流）写出即转发不缓冲。
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# WebSocket proxy
	@ws path /ws/*
	handle @ws {
		reverse_proxy backend:8000
	}

	# frontend-client (end-user app at /client/)
	# 构建产物在 /srv/client/，vite base=/client/ 所以资源引用也是 /client/xxx。
	# 不 strip_prefix：让 /client/* 原样匹配 /srv/client/* 文件路径。
	# SPA fallback：找不到的文件回退到 /client/index.html。
	@client path /client/*
	handle @client {
		# gzip 只压静态资源（js/css/html）：API 流量不进压缩层——SSE 逐 token
		# 小帧压缩纯耗 CPU 且 flush 行为与 Caddy 版本相关（曾挂在全局导致流式卡顿）。
		encode gzip
		root * /srv
		try_files {path} /client/index.html
		file_server
	}

	# frontend-studio (management at /) — SPA fallback to /index.html
	handle {
		encode gzip
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
	}
}
