# Agent Flow 配置文件
# ──────────────────────────────────────────────────────────────────────
# 安全密钥为出厂默认值（模板与启动器兜底一致）；对外暴露公网建议改为
# 强随机值。修改本文件后执行 ./agent-flow restart 生效。
# ──────────────────────────────────────────────────────────────────────

# ── 数据库连接 ────────────────────────────────────────────────────────
# 内置数据库已启用认证，默认用户 agentflow / 密码同 MONGO_ROOT_PASSWORD（默认 changeme）
# 按部署形态改主机名：
#   手动部署（DB 在本机）        → 默认 127.0.0.1 即可
#   Docker 部署（DB 为内置容器） → 改为容器服务名：mongodb / redis / qdrant
#     （./agent-flow start --docker 会自动把 127.0.0.1 替换为容器服务名）
# 手动部署且外接无认证 Mongo：去掉 agentflow:密码@ 部分
MONGODB_URI=mongodb://agentflow:changeme@127.0.0.1:27017/agent_flow?authSource=admin
MONGO_ROOT_USER=agentflow
# MongoDB 镜像版本：默认 7.0；老 CPU（无 AVX 指令集，mongod 启动即 Illegal instruction）
# 改用 4.4：MONGO_IMAGE=mongo:4.4（5.0 起强制要求 AVX）
MONGO_IMAGE=
# 内置数据库（Docker 部署/混合模式）root 密码；手动部署的外接库填实际密码
# ⚠️ 改密码需同步 MONGODB_URI；且仅在 data/mongodb 为空的首次初始化时生效
MONGO_ROOT_PASSWORD=changeme
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
QDRANT_URL=http://127.0.0.1:6333
# Qdrant 开启认证时填写（内置实例默认无认证，留空即可）
QDRANT_API_KEY=

# ── 应用 ──────────────────────────────────────────────────────────────
APP_ENV=production
AF_BACKEND_PORT=8000
LOG_LEVEL=INFO
# 前端跨域白名单（逗号分隔）：通过域名/IP:端口访问时必须包含实际访问地址，
# 否则浏览器拦截 API 请求。示例：https://agentflow.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ── 安全密钥（已内置默认值，一般无需修改；改后已加密数据/登录态失效）──
# JWT 签名密钥（自建默认即可；对外暴露公网建议改强随机值）
JWT_SECRET_KEY=dev-only-not-for-production-replace-me
# 模型 API Key 加密密钥（固定值；⚠️ 改动后已保存的模型 API Key 无法解密）
MODEL_ENCRYPTION_KEY=Tc2zTINsCn0r1B1vQMgGiXvYmmSow5GnoHb5ySc0FMQ=

# ── 数据目录（默认包内 data/，一般无需修改）────────────────────────────
# AF_DATA_DIR = 数据根目录（留空 = 包内 data/）；子目录自动跟随
# 迁移/换机：拷贝整个 data/ 目录到新包 data/ 即可（与原项目布局一致）
# 注意：以下变量仅对手动部署模式生效；Docker 部署的数据路径
# 由 docker-compose.yml 的 volumes 挂载决定，改这里无效
AF_DATA_DIR=
WORKSPACES_HOST_DIR=__AF_DATA_DIR__/workspaces
SKILLS_HOST_DIR=__AF_DATA_DIR__/skills
HOMES_HOST_DIR=__AF_DATA_DIR__/homes
KB_HOST_DIR=__AF_DATA_DIR__/knowledge_bases
AVATARS_HOST_DIR=__AF_DATA_DIR__/avatars
SKILL_AVATARS_HOST_DIR=__AF_DATA_DIR__/skill_avatars

# ── 代码执行沙箱（推荐开启；需要 Docker）───────────────────────────────
# true  = LLM 生成的命令在隔离容器中执行（安全）
# false = 在本机直接执行（无隔离，仅建议内网环境）
SANDBOX_ENABLED=false
SANDBOX_IMAGE=agent-sandbox:latest
# 沙箱不可用（SANDBOX_ENABLED=false 或 Docker 不可用）时 bash 的行为：
#   local = 降级为本机 subprocess 执行（无隔离，每次记 ERROR 日志）
#   never = 拒绝执行（fail closed，公网/生产推荐）
SANDBOX_FALLBACK=local
# 单次命令超时（秒）/ 内存上限 / CPU 配额（100000 = 1 核）/ 输出截断（字节）
SANDBOX_TIMEOUT=120
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=100000
SANDBOX_MAX_OUTPUT_BYTES=51200
# 并发控制：同时运行上限 / 常驻复用池上限（须大于并发上限，0=不限）
# 节点总容量 = worker 并发数 × 并发上限
SANDBOX_MAX_CONCURRENT_CONTAINERS=8
SANDBOX_MAX_CONTAINERS=32
SANDBOX_REUSE_CONTAINER=true
# 容器生命周期：空闲回收（秒）/ 寿命兜底（秒）/ 孤儿清扫年龄（秒，
# 须大于 SANDBOX_TIMEOUT 留足余量）
SANDBOX_CONTAINER_IDLE_TIMEOUT=300
SANDBOX_CONTAINER_MAX_LIFETIME=86400
SANDBOX_ORPHAN_MAX_AGE=600
# 启动时后台预拉取沙盒镜像（首笔执行免付整镜像 pull 耗时）
SANDBOX_PREPULL_IMAGE=true
# bash 沙容器网络：none（默认，无网络最严格）/ bridge（可出网）/ host（共享宿主栈，最不隔离）
SANDBOX_NETWORK_MODE=none
# run_code 工具沙容器网络与工作区挂载（代码即工具编排）
TOOL_SANDBOX_NETWORK_MODE=bridge
TOOL_SANDBOX_MOUNT_WORKSPACE=true

# ── 向量知识库（使用向量检索时填写）────────────────────────────────────
# Embedding 模型（向量化）
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_MODEL=
KB_EMBEDDING_API_KEY=
# Reranker 模型（检索重排，留空=不启用重排）
KB_RERANKER_BASE_URL=
KB_RERANKER_MODEL=
KB_RERANKER_API_KEY=
# 视觉解析模型（图片/PDF 版面解析，留空=不启用）
KB_VISION_BASE_URL=
KB_VISION_MODEL=
KB_VISION_API_KEY=

# ── 授权凭证位置（默认即可）───────────────────────────────────────────
LICENSE_PATH=etc/jasper.identity
# 授权附加开关（正式构建已在编译期强制，一般无需改动）：
#   LICENSE_ENFORCE_EXTRA：非强制构建上也启用授权校验（只能加强不能削弱）
#   LICENSE_SYS_NET_PATH：绑机指纹的网卡目录。手动部署用默认值直读宿主；
#     Docker 由 compose 只读挂载宿主 /sys/class/net 并自动设置，勿改。
#   LICENSE_TRUST_ENV_MAC：AGENT_FLOW_MAC 现为手动覆盖项（正常部署无需
#     设置，设错会留 mismatch 审计日志）；false 时忽略覆盖、强制实测。
# LICENSE_ENFORCE_EXTRA=false
# LICENSE_TRUST_ENV_MAC=true
